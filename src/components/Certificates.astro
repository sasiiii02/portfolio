---
import { getCollection } from 'astro:content';

const certificates = (await getCollection('certificates')).sort((a, b) => a.data.order - b.data.order);

function formatDate(value: string) {
  if (/^\d{4}-\d{2}$/.test(value)) {
    const [year, month] = value.split('-').map(Number);
    return new Date(year, month - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }
  return value;
}
---

<section id="certificates" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6 sm:py-24">
  <p class="reveal font-mono text-sm uppercase tracking-widest text-accent">05. Certificates</p>
  <h2 class="reveal mt-3 font-heading text-3xl font-bold sm:text-4xl">Certificates & Achievements</h2>

  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {certificates.map((cert, index) => (
      <div
        class="reveal flex flex-col rounded-sm border border-border p-5"
        style={`transition-delay: ${index * 60}ms`}
      >
        <p class="font-mono text-xs text-muted">{formatDate(cert.data.date)}</p>
        <h3 class="mt-2 font-heading text-base font-semibold sm:text-lg">{cert.data.name}</h3>
        <p class="mt-1 font-mono text-xs text-accent">{cert.data.issuer}</p>
        {cert.data.description && <p class="mt-3 text-sm text-muted">{cert.data.description}</p>}
        {cert.data.url && (
          <a
            href={cert.data.url}
            target="_blank"
            rel="noreferrer"
            class="mt-4 self-start rounded-sm font-mono text-sm text-text transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            View →
          </a>
        )}
      </div>
    ))}
  </div>
</section>
