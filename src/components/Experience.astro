---
import { getCollection } from 'astro:content';

const experience = (await getCollection('experience')).sort(
  (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
);

function formatMonth(value: string) {
  const [year, month] = value.split('-').map(Number);
  return new Date(year, month - 1).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
}
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6 sm:py-24"
>
  <p class="reveal font-mono text-sm uppercase tracking-widest text-accent">
    02. Experience
  </p>
  <h2
    id="experience-heading"
    class="reveal mt-3 font-heading text-3xl font-bold sm:text-4xl"
  >
    Experience
  </h2>

  <ol class="relative mt-10 border-l border-border pl-6 sm:pl-8">
    {experience.map((item, index) => {
      const isCurrent = item.data.current || !item.data.endDate;
      const dateLabel = `${formatMonth(item.data.startDate)} – ${
        isCurrent ? 'Present' : formatMonth(item.data.endDate!)
      }`;

      return (
        <li
          class="reveal relative pb-12 last:pb-0"
          style={`transition-delay: ${index * 120}ms`}
        >
          <!-- Timeline dot -->
          <span
            class="absolute -left-[29px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-accent sm:-left-[37px]"
            aria-hidden="true"
          />

          <!-- Role + date -->
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="font-heading text-lg font-semibold sm:text-xl">
              {item.data.role}
            </h3>
            <p class="font-mono text-xs text-muted sm:text-sm">{dateLabel}</p>
          </div>

          <!-- Organization + location + current badge -->
          <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
            <p class="font-mono text-sm text-accent">{item.data.organization}</p>

            {item.data.location && (
              <p class="font-mono text-xs text-muted">· {item.data.location}</p>
            )}

            {isCurrent && (
              <span
                class="inline-flex items-center gap-1.5 rounded-sm border border-border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-muted"
              >
                <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent" />
                </span>
                Current
              </span>
            )}
          </div>

          <!-- Summary -->
          {item.data.summary && (
            <p class="mt-3 max-w-3xl text-sm text-muted sm:text-base">
              {item.data.summary}
            </p>
          )}

          <!-- Stack badges -->
          {item.data.stack && item.data.stack.length > 0 && (
            <ul
              class="mt-4 flex flex-wrap gap-2"
              aria-label={`Technologies used at ${item.data.organization}`}
            >
              {item.data.stack.map((tech) => (
                <li class="rounded-sm border border-border px-2 py-0.5 font-mono text-[11px] text-muted">
                  {tech}
                </li>
              ))}
            </ul>
          )}

          <!-- Highlights -->
          <ul class="mt-5 space-y-2 text-sm text-muted sm:text-base">
            {item.data.highlights.map((point) => (
              <li class="flex gap-2">
                <span
                  class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span class="leading-relaxed">{point}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ol>
</section>