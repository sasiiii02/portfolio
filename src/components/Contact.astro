---
import profile from '../content/profile.json';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6 sm:py-24"
>
  <p class="reveal font-mono text-sm uppercase tracking-widest text-accent">
    07. Contact
  </p>
  <h2
    id="contact-heading"
    class="reveal mt-3 font-heading text-3xl font-bold sm:text-4xl"
  >
    Let's work together
  </h2>
  <p class="reveal mt-4 max-w-2xl text-base text-muted sm:text-lg">
    I'm currently interning at TS Technologies and open to full-stack
    Software Engineer roles starting 2026. If you're hiring, or just want to
    talk shop, get in touch — I usually reply within 24 hours.
  </p>

  <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-[1fr_1.3fr] md:gap-16">
    <!-- Left: contact info -->
    <div class="reveal flex flex-col gap-4">
      <!-- Availability strip -->
      <div
        class="rounded-sm border border-accent/40 bg-accent/5 p-4"
        aria-label="Current availability"
      >
        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"
            ></span>
          </span>
          <p class="font-mono text-xs uppercase tracking-wide text-accent">
            Available
          </p>
        </div>
        <p class="mt-2 text-sm text-text">{profile.availability}</p>
        <p class="mt-1 font-mono text-xs text-muted">
          {profile.location} · Remote or hybrid
        </p>
      </div>

      <!-- Direct contact links -->
      <a
        href={`mailto:${profile.email}`}
        class="flex items-center gap-3 rounded-sm border border-border p-4 font-mono text-sm transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        {profile.email}
      </a>

      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-3 rounded-sm border border-border p-4 font-mono text-sm transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          />
        </svg>
        GitHub
      </a>

      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-3 rounded-sm border border-border p-4 font-mono text-sm transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
          />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
        LinkedIn
      </a>

      <!-- Resume download -->
      <a
        href={profile.resumeUrl}
        download
        class="flex items-center gap-3 rounded-sm border border-border p-4 font-mono text-sm transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download CV
      </a>
    </div>

    <!-- Right: form -->
    <form
      id="contact-form"
      class="reveal flex flex-col gap-5"
      novalidate
      aria-describedby="contact-form-help"
    >
      <p id="contact-form-help" class="sr-only">
        All fields are required. Your message is sent directly to my inbox.
      </p>

      <!-- Honeypot -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input
          type="text"
          id="company"
          name="company"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label
          for="name"
          class="font-mono text-xs uppercase tracking-wide text-muted"
        >
          Name
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          aria-describedby="name-error"
          class="rounded-sm border border-border bg-transparent px-3 py-2 text-sm text-text outline-none transition-colors focus:border-accent"
        />
        <p id="name-error" class="hidden text-xs text-danger" role="alert"></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label
          for="email"
          class="font-mono text-xs uppercase tracking-wide text-muted"
        >
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          aria-describedby="email-error"
          class="rounded-sm border border-border bg-transparent px-3 py-2 text-sm text-text outline-none transition-colors focus:border-accent"
        />
        <p id="email-error" class="hidden text-xs text-danger" role="alert"></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label
          for="message"
          class="font-mono text-xs uppercase tracking-wide text-muted"
        >
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          aria-describedby="message-error"
          class="resize-y rounded-sm border border-border bg-transparent px-3 py-2 text-sm text-text outline-none transition-colors focus:border-accent"></textarea>
        <p
          id="message-error"
          class="hidden text-xs text-danger"
          role="alert"
        ></p>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="self-start rounded-sm border border-accent bg-accent px-6 py-2.5 font-mono text-sm font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span id="contact-submit-label">Send message</span>
      </button>

      <p
        id="contact-status"
        class="min-h-5 font-mono text-sm"
        role="status"
        aria-live="polite"
      ></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('contact-submit-label');
  const statusEl = document.getElementById('contact-status');

  function setFieldError(field: string, message: string) {
    const errorEl = document.getElementById(`${field}-error`);
    const inputEl = document.getElementById(field);
    if (!errorEl || !inputEl) return;

    if (message) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      inputEl.setAttribute('aria-invalid', 'true');
    } else {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
      inputEl.removeAttribute('aria-invalid');
    }
  }

  function validate(data: { name: string; email: string; message: string }) {
    let valid = true;

    if (!data.name.trim()) {
      setFieldError('name', 'Please enter your name.');
      valid = false;
    } else {
      setFieldError('name', '');
    }

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(data.email.trim())) {
      setFieldError('email', 'Please enter a valid email address.');
      valid = false;
    } else {
      setFieldError('email', '');
    }

    if (!data.message.trim()) {
      setFieldError('message', 'Please enter a message.');
      valid = false;
    } else {
      setFieldError('message', '');
    }

    return valid;
  }

  function setStatus(
    message: string,
    tone: 'text-accent' | 'text-danger' | 'text-muted'
  ) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('text-accent', 'text-danger', 'text-muted');
    statusEl.classList.add(tone);
  }

  function setLoading(isLoading: boolean) {
    if (submitButton) submitButton.disabled = isLoading;
    if (submitLabel)
      submitLabel.textContent = isLoading ? 'Sending…' : 'Send message';
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    // Honeypot: bots fill every field. Drop silently.
    if (formData.get('company')) {
      return;
    }

    const data = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      message: String(formData.get('message') ?? ''),
    };

    if (!validate(data)) {
      setStatus('Please fix the errors above.', 'text-danger');
      return;
    }

    const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
    if (!accessKey) {
      setStatus(
        'This form is not configured yet — please email me directly.',
        'text-danger'
      );
      return;
    }

    setLoading(true);
    setStatus('', 'text-muted');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ access_key: accessKey, ...data }),
      });

      const result = await response.json();

      if (result.success) {
        setStatus(
          "Thanks — message received. I'll get back to you within 24 hours.",
          'text-accent'
        );
        form.reset();
      } else {
        setStatus(
          'Something went wrong. Please try again or email me directly.',
          'text-danger'
        );
      }
    } catch {
      setStatus(
        'Something went wrong. Please try again or email me directly.',
        'text-danger'
      );
    } finally {
      setLoading(false);
    }
  });
</script>