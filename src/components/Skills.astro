---
import skills from '../content/skills.json';

const categories = Object.entries(skills) as [string, string[]][];
---

<section
  id="skills"
  aria-labelledby="skills-heading"
  class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6 sm:py-24"
>
  <p class="reveal font-mono text-sm uppercase tracking-widest text-accent">
    04. Skills
  </p>
  <h2
    id="skills-heading"
    class="reveal mt-3 font-heading text-3xl font-bold sm:text-4xl"
  >
    Technical Skills
  </h2>
  <p class="reveal mt-4 max-w-2xl text-base text-muted sm:text-lg">
    The stack I ship production code in, plus the tools and platforms I use
    day-to-day.
  </p>

  <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {categories.map(([category, items], index) => {
      const isCore = category === 'Core Stack';

      return (
        <div
          class={`reveal overflow-hidden rounded-sm border ${
            isCore
              ? 'border-accent sm:col-span-2'
              : 'border-border'
          }`}
          style={`transition-delay: ${index * 80}ms`}
        >
          <!-- Category header -->
          <div
            class={`flex items-center justify-between border-b px-4 py-2 font-mono text-xs uppercase tracking-wide ${
              isCore
                ? 'border-accent/40 bg-accent/5 text-accent'
                : 'border-border bg-surface text-muted'
            }`}
          >
            <span>{category}</span>
            {isCore && (
              <span class="text-[10px] text-accent/70">
                {items.length} technologies
              </span>
            )}
          </div>

          <!-- Skill tags -->
          <ul class="flex flex-wrap gap-2 p-4">
            {items.map((skill) => (
              <li
                class={`rounded-sm border px-3 py-1 font-mono text-xs transition-colors ${
                  isCore
                    ? 'border-accent/40 text-text hover:border-accent'
                    : 'border-border text-text hover:border-accent'
                }`}
              >
                {skill}
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>