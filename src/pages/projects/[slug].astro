---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const hasBody = project.body && project.body.trim().length > 0;
---

<BaseLayout title={`${project.data.title} | Projects`} description={project.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <a
      href="/#projects"
      class="reveal rounded-sm font-mono text-sm text-muted transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      ← Back to projects
    </a>

    <h1 class="reveal mt-6 font-heading text-3xl font-bold sm:text-4xl">{project.data.title}</h1>
    <p class="reveal mt-2 text-base text-muted sm:text-lg">{project.data.description}</p>

    {project.data.image && (
      <div class="reveal mt-8 aspect-square overflow-hidden rounded-sm border border-border bg-surface">
        <Image
          src={project.data.image}
          alt={`Screenshot of the ${project.data.title} interface`}
          width={1200}
          height={1200}
          class="h-full w-full object-cover"
        />
      </div>
    )}

    <ul class="reveal mt-6 flex flex-wrap gap-2">
      {project.data.tech.map((tech) => (
        <li class="rounded-sm border border-border px-2 py-1 font-mono text-xs text-muted">{tech}</li>
      ))}
    </ul>

    <div class="reveal mt-6 flex flex-wrap gap-4 font-mono text-sm">
      {project.data.links.github && (
        <a
          href={project.data.links.github}
          target="_blank"
          rel="noreferrer"
          class="rounded-sm border border-border px-4 py-2 text-text transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Code
        </a>
      )}
      {project.data.links.demo && (
        <a
          href={project.data.links.demo}
          target="_blank"
          rel="noreferrer"
          class="rounded-sm border border-accent bg-accent px-4 py-2 text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Live demo
        </a>
      )}
    </div>

    {hasBody && (
      <div class="reveal markdown-body mt-10 max-w-none">
        <Content />
      </div>
    )}

    <nav class="mt-16 flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      {prev ? (
        <a
          href={`/projects/${prev.id}/`}
          class="rounded-sm font-mono text-sm text-muted transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          ← {prev.data.title}
        </a>
      ) : <span />}
      {next ? (
        <a
          href={`/projects/${next.id}/`}
          class="rounded-sm font-mono text-sm text-muted transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:text-right"
        >
          {next.data.title} →
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .markdown-body :global(h2) {
    margin-top: 2rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .markdown-body :global(h2:first-child) {
    margin-top: 0;
  }

  .markdown-body :global(p) {
    margin-top: 0.75rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .markdown-body :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-muted);
  }

  .markdown-body :global(li) {
    margin-top: 0.4rem;
    line-height: 1.6;
  }

  .markdown-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .markdown-body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 2px;
  }
</style>
